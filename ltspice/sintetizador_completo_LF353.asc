TEXT -1904 -944 Left 2 ;Salidas: graficar V(sq), V(saw), V(tri), V(sine)
TEXT -1904 -896 Left 2 ;Todas las fuentes y opamps usan este mismo esquematico; el modelo LF353/NS esta en lf353.mod.
SYMBOL voltage -1792 -1216 R0
SYMATTR InstName Vsq
SYMATTR Value PULSE(-5 5 0 {tr} {tr} {1/(2*f0)-tr} {1/f0})
FLAG -1792 -1200 sq
FLAG -1792 -1120 0
SYMBOL voltage -1120 -1216 R0
SYMATTR InstName Vsaw
SYMATTR Value PULSE(0 {VsawPk} 0 {0.96/(2*f0)} {0.02/(2*f0)} {0.01/(2*f0)} {1/(2*f0)})
FLAG -1120 -1200 saw
FLAG -1120 -1120 0
SYMBOL voltage -448 -1216 R0
SYMATTR InstName Vtri
SYMATTR Value PULSE({-VtriPk} {VtriPk} 0 {1/f0} {1/f0} 1n {2/f0}) AC 1
FLAG -448 -1200 tri
FLAG -448 -1120 0
