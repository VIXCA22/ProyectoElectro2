TEXT -1904 -448 Left 0 !.include "lf353.mod"
TEXT -1904 -408 Left 0 !.param X=2
TEXT -1904 -368 Left 0 !.param Y=2
TEXT -1904 -328 Left 0 !.param Z=9
TEXT -1904 -288 Left 0 !.param f0={1k*(X+Y/10+Z/100)}
TEXT -1904 -248 Left 0 !.param ftri={f0/2}
TEXT -1904 -208 Left 0 !.param tr={1/(500*f0)}
TEXT -1904 -168 Left 0 !.param VsawPk=5
TEXT -1904 -128 Left 0 !.param VtriPk=2
TEXT -1904 -88 Left 0 !.param fc={1.25*ftri}
TEXT -1904 -48 Left 0 !.param resp={if(Z<4,1,if(Z<7,2,3))}
TEXT -1904 -8 Left 0 !.param Cf=10n
TEXT -1904 32 Left 0 !.param Rgain=10k
TEXT -1904 72 Left 0 !.param p1mul={if(resp==1,1.5023162714,if(resp==2,1,0.3623196242))}
TEXT -1904 112 Left 0 !.param s1mul={if(resp==1,1.5563471223,if(resp==2,1,0.6904831735))}
TEXT -1904 152 Left 0 !.param q1={if(resp==1,0.5635356209,if(resp==2,0.6180339887,1.1778055654))}
TEXT -1904 192 Left 0 !.param s2mul={if(resp==1,1.7553777766,if(resp==2,1,1.0177347431))}
TEXT -1904 232 Left 0 !.param q2={if(resp==1,0.9164773739,if(resp==2,1.6180339887,4.5449633297))}
TEXT -1904 272 Left 0 !.param k1={3-1/q1}
TEXT -1904 312 Left 0 !.param k2={3-1/q2}
TEXT -1904 352 Left 0 !.param Rlp1={1/(2*pi*fc*p1mul*Cf)}
TEXT -1904 392 Left 0 !.param Rsk1={1/(2*pi*fc*s1mul*Cf)}
TEXT -1904 432 Left 0 !.param Rsk2={1/(2*pi*fc*s2mul*Cf)}
TEXT -1904 472 Left 0 !.param RattBot=100k
TEXT -1904 512 Left 0 !.param RattTop={RattBot*(k1*k2-1)}
TEXT -1904 576 Left 0 !.options plotwinsize=0 reltol=0.001 abstol=1n
TEXT -1904 616 Left 0 !.save V(sq) V(saw) V(tri) V(sine)
TEXT -1904 656 Left 0 !.tran 0 {8/ftri} 0 {1/(500*f0)}
TEXT -1904 696 Left 0 !.meas tran T_square TRIG V(sq) VAL=0 RISE=3 TARG V(sq) VAL=0 RISE=4
TEXT -1904 736 Left 0 !.meas tran f_square PARAM 1/T_square
TEXT -1904 776 Left 0 !.meas tran T_saw TRIG V(saw) VAL={VsawPk/2} RISE=5 TARG V(saw) VAL={VsawPk/2} RISE=6
TEXT -1904 816 Left 0 !.meas tran f_saw PARAM 1/T_saw
TEXT -1904 856 Left 0 !.meas tran T_tri TRIG V(tri) VAL=0 RISE=3 TARG V(tri) VAL=0 RISE=4
TEXT -1904 896 Left 0 !.meas tran f_tri PARAM 1/T_tri
